# Copy to .env.local for local development. On GitHub these are Actions variables.

# Public URL of the site (no trailing slash). Used for canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://nazya-why.github.io/nadent-site
# Sub-path when hosted at /<repo> on GitHub Pages; empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Lead forms: URL of the Cloudflare Worker from /worker. Empty = demo mode (leads stay in the browser).
NEXT_PUBLIC_LEAD_ENDPOINT=
# Cloudflare Turnstile site key (spam protection). Empty = disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics — loaded only after cookie consent.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Call tracking: replaces the phone number site-wide.
NEXT_PUBLIC_TRACKING_PHONE_DISPLAY=
NEXT_PUBLIC_TRACKING_PHONE_TEL=

# Only "true" when available slots really come from a CRM (never fake scarcity).
NEXT_PUBLIC_LIVE_SLOTS=false

# A/B: hero headline variant (calm | smile)
NEXT_PUBLIC_HERO_VARIANT=calm
